instance={{ sid }}; export instance
BASE={{ db_os_user_basedir }}; export BASE
PORT={{ port }}; export PORT

# MySQL environment
DBOWNER=`id -un`; export DBOWNER
INSTANCE_NAME=`echo $instance | tr [:lower:] [:upper:]`; export INSTANCE_NAME;
BASE=${BASE}; export BASE
MYSQLD_PORT=${PORT}; export MYSQLD_PORT 

HOMEDIR=${BASE}/v1/admin; export HOMEDIR 
DATADIR={{ datadir }}; export DATADIR
ARCH_LOC=${BASE}/v2/archlog/${INSTANCE_NAME}; export ARCH_LOC
{% if deploy_using_ck_dir_structure != 'no'  %}
BINARY_LOG_DIR=$( dirname {{ log_bin }} ); export BINARY_LOG_DIR
RELAY_LOG_DIR=$( dirname {{ relay_log }} ); export RELAY_LOG_DIR
GENERAL_LOG_DIR=$( dirname {{ general_log_file }} ); export GENERAL_LOG_DIR
SLOW_LOG_DIR=$( dirname {{ slow_query_log_file }} ); export SLOW_LOG_DIR
{% endif %}
INNO_LOC=${BASE}/v2/archlog/${INSTANCE_NAME}/INNODB; export INNO_LOC
BACKUP_LOC=/dbbackup/$DBOWNER/${INSTANCE_NAME}; export BACKUP_LOC
CFG_LOC=${HOMEDIR}/${INSTANCE_NAME}/cfg; export CFG_LOC 
LOG_LOC=${HOMEDIR}/${INSTANCE_NAME}/logs; export LOG_LOC
TMP_LOC=${BASE}/v1/admin/${INSTANCE_NAME}/tmp; export TMP_LOC
BIN_LOC=${HOMEDIR}/${INSTANCE_NAME}/bin; export BIN_LOC
CERT_LOC=${HOMEDIR}/${INSTANCE_NAME}/certs; export CERT_LOC
PID_FILE=${CFG_LOC}/${INSTANCE_NAME}.pid; export PID_FILE
SOCKET_FILE=${CFG_LOC}/${INSTANCE_NAME}mysql.sock; export SOCKET_FILE
PATH=${BIN_LOC}:${PATH}:.; export PATH
ERR_LOG='{{ log_error }}'; export ERR_LOG
CNF_FILE=${CFG_LOC}/my_${INSTANCE_NAME}.cnf; export CNF_FILE
MYSQL_UNIX_PORT=${CFG_LOC}/${INSTANCE_NAME}mysql.sock; export MYSQL_UNIX_PORT
MYSSQL_TCP_PORT=${MYSQLD_PORT}; export MYSSQL_TCP_PORT

alias mlog='cd ${LOG_LOC}'
alias march='cd ${ARCH_LOC}'
alias plist='mysql -u{{ db_os_user }}   -S ${SOCKET_FILE} -e "show processlist"'
alias mstat='mysql -u{{ db_os_user }} -S ${SOCKET_FILE} -e "show master status\G"'
alias slstat='mysql -u{{ db_os_user }} -S ${SOCKET_FILE} -e "show slave status\G"'
alias rels='cd ${HOMEDIR}/${INSTANCE_NAME}/release'
