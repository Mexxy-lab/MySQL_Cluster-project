# wsrep_cluster_name="lab-mariadb-galera"


### Galera Config starts ####
{% if configure_galera != None %}
[galera]

# wsrep-new-cluster must ONLY be enabled for the initial bootstrap
# of the first master node. It must remain commented for worker nodes.
#wsrep-new-cluster

wsrep_on=on
wsrep_cluster_address="{{ wsrep_cluster_address }}"
wsrep_node_name={{ hostname }}
wsrep_provider=/usr/lib64/galera-4/libgalera_smm.so
wsrep_node_address={{ host_ip }}
wsrep_log_conflicts=on

# Galera replication
binlog_format=row
default_storage_engine=InnoDB
innodb_autoinc_lock_mode=2
bind-address=0.0.0.0

# Galera cluster
wsrep_cluster_name="lab-mariadb-galera"

# SST
# mariabackup is required because the InnoDB redo logs are stored
# outside the datadir in innodb_log_group_home_dir.
wsrep_sst_method=mariabackup

{% endif %}
### Galera Config Ends ####

[sst]
# Disable SST TLS certificate verification.
# Required for the lab certificate configuration.
ssl-mode=DISABLED