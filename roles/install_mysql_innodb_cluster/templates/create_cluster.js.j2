
shell.connect({
  user: "{{ mysql_cluster_admin_user }}",
  password: "{{ mysql_cluster_admin_password }}",
  host: "localhost",
  port: {{ mysql_server_port }}
});

var session = shell.getSession();
var clusterName = "{{ mysql_cluster_name }}";

var masterHost = "{{ hostvars[groups['master'][0]].ansible_host }}";
var workerHost = "{{ hostvars[groups['workers'][0]].ansible_host }}";

var masterAddress = masterHost + ":{{ mysql_server_port }}";
var workerAddress = workerHost + ":{{ mysql_server_port }}";

var masterConnection = {
  user: "{{ mysql_cluster_admin_user }}",
  password: "{{ mysql_cluster_admin_password }}",
  host: masterHost,
  port: {{ mysql_server_port }}
};

var workerConnection = {
  user: "{{ mysql_cluster_admin_user }}",
  password: "{{ mysql_cluster_admin_password }}",
  host: workerHost,
  port: {{ mysql_server_port }}
};

function getExistingCluster() {
  try {
    return dba.getCluster(clusterName);
  } catch (e) {
    return null;
  }
}

function findMember(topology, address) {
  var found = null;

  Object.keys(topology).some(function (key) {
    var member = topology[key];

    if (
      key === address ||
      member.address === address
    ) {
      found = member;
      return true;
    }

    return false;
  });

  return found;
}

var metadataResult = session.runSql(
  "SELECT COUNT(*) FROM information_schema.schemata " +
  "WHERE schema_name = 'mysql_innodb_cluster_metadata'"
);

var metadataExists = Number(metadataResult.fetchOne()[0]) > 0;
var cluster;

if (!metadataExists) {
  print("No existing cluster metadata found. Creating " + clusterName + ".");

  // The master is the connected local instance.
  // InnoDB Cluster defaults to Single-Primary mode.
  cluster = dba.createCluster(clusterName, {
    communicationStack: "MYSQL",
    memberSslMode: "DISABLED",
    manualStartOnBoot: false,
    autoRejoinTries: 3
  });

  print("Adding worker: " + workerAddress);

  cluster.addInstance(workerConnection, {
    recoveryMethod: "clone"
  });

} else {
  print("Existing cluster metadata found. Preserving " + clusterName + ".");

  // Allow Group Replication time to start automatically after a VM reboot.
  cluster = getExistingCluster();

  for (var attempt = 0; cluster === null && attempt < 30; attempt++) {
    print("Waiting for Group Replication startup (" + (attempt + 1) + "/30).");
    os.sleep(2);
    cluster = getExistingCluster();
  }

  if (cluster === null) {
    print("Group Replication remains inactive. Attempting outage recovery.");

    var lastRecoveryError = null;

    for (
      var recoveryAttempt = 1;
      recoveryAttempt <= 12 && cluster === null;
      recoveryAttempt++
    ) {
      print("Recovery attempt " + recoveryAttempt + "/12.");

      cluster = getExistingCluster();

      if (cluster !== null) {
        break;
      }

      try {
        cluster = dba.rebootClusterFromCompleteOutage(clusterName);
      } catch (recoveryError) {
        lastRecoveryError = recoveryError;
        print("Recovery attempt failed: " + recoveryError.message);
        cluster = getExistingCluster();
      }

      if (cluster === null && recoveryAttempt < 12) {
        print("Waiting 10 seconds before retrying recovery.");
        os.sleep(10);
      }
    }

    if (cluster === null) {
      throw new Error(
        "Cluster recovery failed after 12 attempts. " +
        "No cluster object is available. Check MySQL logs and " +
        "member connectivity before attempting manual recovery. " +
        "Last error: " +
        (lastRecoveryError ? lastRecoveryError.message : "unknown")
      );
    }
  }

  // Check the worker only when recovering an existing cluster.
  var status = cluster.status();
  var topology = status.defaultReplicaSet.topology;
  var workerMember = findMember(topology, workerAddress);

  if (!workerMember) {
    print("Worker is missing from cluster metadata. Adding " + workerAddress + ".");

    cluster.addInstance(workerConnection, {
      recoveryMethod: "clone"
    });

  } else if (workerMember.status !== "ONLINE") {
    print("Worker is registered but not ONLINE. Attempting to rejoin it.");

    cluster.rejoinInstance(workerConnection, {
      recoveryMethod: "incremental"
    });

  } else {
    print("Worker is already ONLINE.");
  }
}

// Enforce Single-Primary mode with the inventory master as primary.
var currentStatus = cluster.status();
var currentReplicaSet = currentStatus.defaultReplicaSet;

if (currentReplicaSet.topologyMode !== "Single-Primary") {
  print("Switching cluster to Single-Primary mode with master as primary.");

  cluster.switchToSinglePrimaryMode(masterAddress);

} else {
  // Single-Primary mode may already be active but have a different primary.
  var currentTopology = currentReplicaSet.topology;
  var currentMasterMember = findMember(currentTopology, masterAddress);

  if (!currentMasterMember) {
    throw new Error(
      "Cannot select the inventory master as primary: " +
      masterAddress + " is not present in cluster metadata."
    );
  }

  if (currentMasterMember.status !== "ONLINE") {
    throw new Error(
      "Cannot select the inventory master as primary: " +
      masterAddress + " is not ONLINE."
    );
  }

  if (currentMasterMember.mode !== "R/W") {
    print("The worker or another member is currently primary.");
    print("Promoting inventory master: " + masterAddress);

    cluster.setPrimaryInstance(masterAddress);

  } else {
    print("Cluster is already Single-Primary with the master as primary.");
  }
}

// Validate both expected members and their access modes.
var finalStatus = cluster.status({ extended: 1 });
var finalReplicaSet = finalStatus.defaultReplicaSet;
var finalTopology = finalReplicaSet.topology;

var finalMaster = findMember(finalTopology, masterAddress);
var finalWorker = findMember(finalTopology, workerAddress);

if (
  !finalMaster ||
  finalMaster.status !== "ONLINE" ||
  finalMaster.mode !== "R/W"
) {
  throw new Error(
    "Cluster validation failed for master " + masterAddress +
    ". Expected ONLINE and R/W. Actual: " +
    JSON.stringify(finalMaster || null)
  );
}

if (
  !finalWorker ||
  finalWorker.status !== "ONLINE" ||
  finalWorker.mode !== "R/O"
) {
  throw new Error(
    "Cluster validation failed for worker " + workerAddress +
    ". Expected ONLINE and R/O. Actual: " +
    JSON.stringify(finalWorker || null)
  );
}

if (finalReplicaSet.topologyMode !== "Single-Primary") {
  throw new Error(
    "Cluster validation failed: expected Single-Primary mode."
  );
}

print("Cluster validation successful.");
print("Master primary: " + masterAddress);
print("Worker secondary: " + workerAddress);
print("Final cluster status:");
print(JSON.stringify(finalStatus, null, 2));
